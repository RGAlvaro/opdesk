APP_ENV=local
DEBUG=true

POSTGRES_USER=opdesk
POSTGRES_PASSWORD=opdesk_dev_password
POSTGRES_DB=opdesk
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://opdesk:opdesk_dev_password@postgres:5432/opdesk
LOCAL_DATABASE_URL=postgresql+psycopg://opdesk:opdesk_dev_password@localhost:5432/opdesk
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

ADMINER_PORT=8080
FRONTEND_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:8000

AUTH_SECRET_KEY=local_dev_change_me_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Production deployment values. Copy these to a server-side env file and replace
# every placeholder secret before running docker-compose.prod.yml.
CADDY_SITE_ADDRESS=example.com
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443
# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB and URL-encode any
# special characters in the password, for example @ as %40 and : as %3A.
PROD_DATABASE_URL=postgresql+psycopg://opdesk:replace_with_url_encoded_password@postgres:5432/opdesk
